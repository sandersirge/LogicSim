{
	"format": "logicsim",
	"version": 1,
	"circuit": {
		"name": "Basics",
		"components": [
			{"id": 1, "type": "switch", "x": 2, "y": 2, "label": "A"},
			{"id": 2, "type": "switch", "x": 2, "y": 9, "label": "B", "props": {"value": 1}},
			{"id": 3, "type": "and", "x": 8, "y": 2},
			{"id": 4, "type": "or", "x": 8, "y": 8},
			{"id": 5, "type": "xor", "x": 8, "y": 14},
			{"id": 6, "type": "led", "x": 15, "y": 3, "label": "A AND B"},
			{"id": 7, "type": "led", "x": 15, "y": 9, "label": "A OR B"},
			{"id": 8, "type": "led", "x": 15, "y": 15, "label": "A XOR B", "props": {"color": "#40a0ff"}},

			{"id": 10, "type": "switch", "x": 22, "y": 2, "label": "R"},
			{"id": 11, "type": "switch", "x": 22, "y": 9, "label": "S"},
			{"id": 12, "type": "nor", "x": 28, "y": 2},
			{"id": 13, "type": "nor", "x": 28, "y": 7},
			{"id": 14, "type": "led", "x": 38, "y": 3, "label": "Q"},
			{"id": 15, "type": "led", "x": 38, "y": 8, "label": "Qn", "props": {"color": "#ffb030"}},
			{"id": 16, "type": "text", "x": 25, "y": 12, "props": {"text": "SR latch from NOR gates"}},

			{"id": 20, "type": "clock", "x": 22, "y": 17, "label": "clock"},
