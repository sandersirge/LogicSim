		"wires": [
			{"from": [1, "out"], "to": [3, "in0"]},
			{"from": [2, "out"], "to": [3, "in1"], "bends": [[6, 10], [6, 5]]},
			{"from": [1, "out"], "to": [4, "in0"], "bends": [[5, 3], [5, 9]]},
			{"from": [2, "out"], "to": [4, "in1"], "bends": [[6, 10], [6, 11]]},
			{"from": [1, "out"], "to": [5, "in0"], "bends": [[5, 3], [5, 15]]},
			{"from": [2, "out"], "to": [5, "in1"], "bends": [[6, 10], [6, 17]]},
			{"from": [3, "out"], "to": [6, "in"]},
			{"from": [4, "out"], "to": [7, "in"]},
			{"from": [5, "out"], "to": [8, "in"]},

			{"from": [10, "out"], "to": [12, "in0"]},
			{"from": [11, "out"], "to": [13, "in1"]},
			{"from": [13, "out"], "to": [12, "in1"], "bends": [[33, 9], [33, 6], [27, 6], [27, 5]]},
			{"from": [12, "out"], "to": [13, "in0"], "bends": [[34, 4], [34, 7], [26, 7], [26, 8]]},
			{"from": [12, "out"], "to": [14, "in"]},
			{"from": [13, "out"], "to": [15, "in"]},

			{"from": [20, "out"], "to": [21, "CLK"]},
			{"from": [21, "Q"], "to": [22, "in"]}
		]
